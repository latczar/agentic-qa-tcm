# Copy to .env to override the defaults baked into docker-compose.yml.
# Compose reads .env automatically. Nothing here is a real secret; this stack is local only.
POSTGRES_USER=aiqa
POSTGRES_PASSWORD=aiqa
POSTGRES_DB=aiqa
POSTGRES_PORT=5432
N8N_PORT=5678
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Orchestrator (phase 5 and 6). Defaults shown; everything runs locally.
# LLM_PROVIDER=replay        # replay | failing | ollama
# LLM_MODEL=qwen2.5-coder:7b
# OLLAMA_URL=http://localhost:11434
# AGENT_MODE=curated         # curated | agentic
# LLM_TIMEOUT_MS=600000

# Orchestrator (phase 8). Unset EVENTS_WEBHOOK_URL disables notifications entirely.
# EVENTS_WEBHOOK_URL=http://localhost:5678/webhook/run-events
# PUBLIC_URL=http://localhost:5000
